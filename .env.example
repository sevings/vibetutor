# Скопируйте в .env и заполните. Используется docker-compose.
VIBETUTOR_TELEGRAM_TOKEN=123456789:REPLACE_WITH_YOUR_TOKEN
VIBETUTOR_OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
VIBETUTOR_OPENAI_BASE_URL=https://api.openai.com/v1
VIBETUTOR_OPENAI_MODEL=gpt-4o-mini
# Список ID через запятую, либо пусто для доступа всем.
VIBETUTOR_ALLOWED_USERS=
